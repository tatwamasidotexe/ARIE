# Database
DATABASE_URL=postgresql://arie:arie@localhost:5432/arie

# Redis
REDIS_URL=redis://localhost:6379/0

# Groq
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face (local embeddings via sentence-transformers)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_RERANKER_MODEL=BAAI/bge-reranker-small

# Reddit API (PRAW)
REDDIT_CLIENT_ID=xxx
REDDIT_CLIENT_SECRET=xxx
REDDIT_USER_AGENT=ARIE/1.0

# arXiv ingestion (python -m ingestion.ingest_arxiv)
ARXIV_MAX_RESULTS=500
ARXIV_DAYS_BACK=7
# Polite delay between paginated API calls (arXiv recommends >= 3s)
ARXIV_REQUEST_DELAY_SEC=3

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
